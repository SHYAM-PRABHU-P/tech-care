    {
      "parameters": {
        "jsCode": "\nconst inputEmail = $node[\"Webhook\"].json.body.email;\nif (!inputEmail) {\n    return [{ json: { status: \"error_no_email\" } }];\n}\n\nlet exists = false;\n\nfor (let row of items) {\n    if (\n        row.json.Email &&\n        row.json.Email.toLowerCase().trim() === inputEmail.toLowerCase().trim()\n    ) {\n        exists = true;\n        break;\n    }\n}\n\nreturn [\n  {\n    json: {\n      status: exists ? \"already_exists\" : \"new_user\"\n    }\n  }\n];"
      },
